---
layout: null
permalink: /search.json
---
[
{%- for p in site.posts -%}
{%- assign key = p.categories | first -%}
{
  "t": {{ p.title | jsonify }},
  "u": {{ p.url | relative_url | jsonify }},
  "d": {{ p.date | date: "%Y-%m-%d" | jsonify }},
  "s": {{ key | jsonify }},
  "g": {{ p.tags | jsonify }},
  "m": {{ p.summary | default: "" | jsonify }},
  "c": {{ p.content | strip_html | normalize_whitespace | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
